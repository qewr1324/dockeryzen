{
	"name": "dockeryzen",
	"type": "module",
	"displayName": "Dockeryzen",
	"description": "🧢 Dockeryzen - Automatic Dockerfile and Docker Compose build for multiple languages and frameworks for 💠 VSCode.",
	"version": "0.143.304",
	"private": false,
	"publisher": "GhurbeSABZI",
	"packageManager": "bun@1.3.14",
	"author": "GhurbeSABZI <naiad.arts.studio@gmail.com>",
	"icon": "res/dockeryzen-icon-big.png",
	"license": "MIT",
	"homepage": "https://github.com/qewr1324/dockeryzen#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/qewr1324/dockeryzen"
	},
	"bugs": {
		"url": "https://github.com/qewr1324/dockeryzen/issues"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"keywords": [
		"dockeryzen",
		"docker",
		"dockerfile",
		"docker-compose",
		"dockerignore",
		"java",
		"spring-boot",
		"quarkus",
		"micronaut",
		"maven",
		"gradle",
		"python",
		"django",
		"flask",
		"fastapi",
		"nodejs",
		"nextjs",
		"angular",
		"nuxtjs",
		"golang",
		"rust",
		"dotnet",
		"laravel",
		"rails",
		"postgresql",
		"mysql",
		"mongodb",
		"redis",
		"kafka",
		"rabbitmq",
		"vscode-extension",
		"config",
		"generator",
		"wizard"
	],
	"categories": [
		"Programming Languages",
		"Other"
	],
	"galleryBanner": {
		"color": "#0D1117",
		"theme": "dark"
	},
	"preview": false,
	"qna": "marketplace",
	"activationEvents": [
		"onStartupFinished",
		"onCommand:dockeryzen.openSettings",
		"onCommand:dockeryzen.generateFromConfig",
		"onCommand:dockeryzen.openConfigSettings"
	],
	"main": "./dist/extension.cjs",
	"contributes": {
		"commands": [
			{
				"command": "dockeryzen.generateFromConfig",
				"title": "Dockeryzen: Generate",
				"category": "Dockeryzen"
			},
			{
				"command": "dockeryzen.openSettings",
				"title": "Dockeryzen: Open Settings",
				"category": "Dockeryzen"
			},
			{
				"command": "dockeryzen.openConfigSettings",
				"title": "Dockeryzen: Open Configuration Settings",
				"category": "Dockeryzen"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "dockeryzen.generateFromConfig",
					"when": "workspaceFolderCount > 0"
				},
				{
					"command": "dockeryzen.openSettings",
					"when": "workspaceFolderCount > 0"
				}
			],
			"explorer/context": [
				{
					"command": "dockeryzen.generateFromConfig",
					"when": "explorerResourceIsFolder",
					"group": "dockeryzen@1"
				}
			],
			"editor/context": [
				{
					"command": "dockeryzen.generateFromConfig",
					"when": "editorTextFocus",
					"group": "dockeryzen@1"
				}
			]
		},
		"keybindings": [
			{
				"command": "dockeryzen.generateFromConfig",
				"key": "ctrl+shift+d",
				"mac": "cmd+shift+d",
				"when": "editorTextFocus && workspaceFolderCount > 0"
			}
		],
		"configuration": {
			"title": "Dockeryzen",
			"properties": {
				"dockeryzen.defaultPort": {
					"type": "number",
					"default": 8080,
					"description": "Default port for the application"
				},
				"dockeryzen.defaultJDKVersion": {
					"type": "string",
					"default": "17",
					"enum": [
						"8",
						"11",
						"17",
						"21",
						"25"
					],
					"description": "Default JDK version"
				},
				"dockeryzen.defaultJDKVendor": {
					"type": "string",
					"default": "eclipse-temurin",
					"enum": [
						"eclipse-temurin",
						"amazoncorretto",
						"openjdk",
						"oracle-jdk"
					],
					"description": "Default JDK vendor"
				},
				"dockeryzen.defaultBuildTool": {
					"type": "string",
					"default": "maven",
					"enum": [
						"maven",
						"gradle"
					],
					"description": "Default build tool for Java projects"
				},
				"dockeryzen.defaultNodeVersion": {
					"type": "string",
					"default": "18",
					"enum": [
						"18",
						"20",
						"22"
					],
					"description": "Default Node.js version"
				},
				"dockeryzen.defaultPythonVersion": {
					"type": "string",
					"default": "3.11",
					"enum": [
						"3.9",
						"3.10",
						"3.11",
						"3.12"
					],
					"description": "Default Python version"
				},
				"dockeryzen.useAlpineByDefault": {
					"type": "boolean",
					"default": false,
					"description": "Use Alpine-based images by default"
				},
				"dockeryzen.enableHealthCheckByDefault": {
					"type": "boolean",
					"default": false,
					"description": "Enable health check by default"
				},
				"dockeryzen.enableDebugByDefault": {
					"type": "boolean",
					"default": false,
					"description": "Enable debug mode by default"
				},
				"dockeryzen.debugPort": {
					"type": "number",
					"default": 5005,
					"description": "Debug port for applications"
				},
				"dockeryzen.generateDockerignore": {
					"type": "boolean",
					"default": true,
					"description": "Generate .dockerignore file"
				},
				"dockeryzen.generateDockerCompose": {
					"type": "boolean",
					"default": true,
					"description": "Generate docker-compose.yml file"
				},
				"dockeryzen.showSuccessNotification": {
					"type": "boolean",
					"default": true,
					"description": "Show success notification after generation"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "bun run build",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"build": "tsdown src/extension.ts --external vscode",
		"dev": "bun run build --watch --sourcemap",
		"prepare": "echo 'Skipping update'",
		"update": "echo 'Skipping vscode-ext-gen'",
		"lint": "eslint .",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"ext:package": "vsce package --no-dependencies",
		"ext:publish": "vsce publish --no-dependencies"
	},
	"dependencies": {
		"@iarna/toml": "^2.2.5",
		"dockerode": "^4.0.2",
		"fs-extra": "^11.2.0",
		"handlebars": "^4.7.8",
		"js-yaml": "^5.4.1",
		"xml2js": "^0.6.2"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^6.7.3",
		"@antfu/ni": "^28.0.0",
		"@types/fs-extra": "^11.0.4",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^3.7.1",
		"bumpp": "^10.3.2",
		"eslint": "^9.39.2",
		"ovsx": "^0.10.7",
		"reactive-vscode": "^1.0.0-beta.2",
		"taze": "^19.9.2",
		"tsdown": "^0.19.0-beta.3",
		"typescript": "^5.3.0",
		"vite": "^7.3.0",
		"vitest": "^4.0.16",
		"vscode-ext-gen": "^1.5.1",
		"vsxpub": "^0.1.2"
	}
}