{
	"name": "dockeryzen",
	"type": "module",
	"displayName": "Dockeryzen",
	"description": "🧢 Dockeryzen - Automatic Dockerfile and Docker Compose build for Java projects for 💠 VSCode.",
	"version": "0.57.82",
	"private": false,
	"publisher": "GhurbeSABZI",
	"packageManager": "bun@1.3.14",
	"author": "GhurbeSABZI <naiad.arts.studio@gmail.com>",
	"icon": "res/dockeryzen-icon-big.png",
	"license": "MIT",
	"homepage": "https://github.com/qewr1324/dockeryzen#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/qewr1324/dockeryzen"
	},
	"bugs": {
		"url": "https://github.com/qewr1324/dockeryzen/issues"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"keywords": [
		"dockeryzen",
		"docker",
		"dockerfile",
		"docker-compose",
		"java",
		"spring-boot",
		"maven",
		"gradle",
		"vscode-extension"
	],
	"categories": [
		"Programming Languages",
		"Other"
	],
	"galleryBanner": {
		"color": "#0D1117",
		"theme": "dark"
	},
	"preview": false,
	"qna": "marketplace",
	"activationEvents": [
		"onStartupFinished",
		"onCommand:dockeryzen.analyze",
		"onCommand:dockeryzen.generate",
		"onCommand:dockeryzen.generate-all",
		"onCommand:dockeryzen.quick-generate",
		"onCommand:dockeryzen.update",
		"onCommand:dockeryzen.add-database",
		"onCommand:dockeryzen.show-logs",
		"onCommand:dockeryzen.health-check",
		"onCommand:dockeryzen.generate-dev-container",
		"onView:dockeryzen.dockerExplorer"
	],
	"main": "./dist/extension.cjs",
	"contributes": {
		"commands": [
			{
				"command": "dockeryzen.analyze",
				"title": "Analyze Java Project",
				"category": "Dockeryzen",
				"icon": "$(search)"
			},
			{
				"command": "dockeryzen.generate",
				"title": "Generate Docker Files",
				"category": "Dockeryzen",
				"icon": "$(file-code)"
			},
			{
				"command": "dockeryzen.generate-all",
				"title": "Generate All Docker Files (Auto)",
				"category": "Dockeryzen",
				"icon": "$(zap)"
			},
			{
				"command": "dockeryzen.quick-generate",
				"title": "Quick Generate (Default Settings)",
				"category": "Dockeryzen",
				"icon": "$(rocket)"
			},
			{
				"command": "dockeryzen.update",
				"title": "Update Existing Docker Files",
				"category": "Dockeryzen",
				"icon": "$(refresh)"
			},
			{
				"command": "dockeryzen.add-database",
				"title": "Add Database Service",
				"category": "Dockeryzen",
				"icon": "$(database)"
			},
			{
				"command": "dockeryzen.show-logs",
				"title": "Show Dockeryzen Logs",
				"category": "Dockeryzen",
				"icon": "$(output)"
			},
			{
				"command": "dockeryzen.health-check",
				"title": "Check Container Health",
				"category": "Dockeryzen",
				"icon": "$(pulse)"
			},
			{
				"command": "dockeryzen.generate-dev-container",
				"title": "Generate Dev Container",
				"category": "Dockeryzen",
				"icon": "$(container)"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "dockeryzen.generate",
					"when": "explorerResourceIsFolder",
					"group": "dockeryzen@1"
				},
				{
					"command": "dockeryzen.analyze",
					"when": "explorerResourceIsFolder",
					"group": "dockeryzen@2"
				},
				{
					"command": "dockeryzen.add-database",
					"when": "resourceFilename =~ /docker-compose\\.ya?ml/",
					"group": "dockeryzen@3"
				}
			],
			"editor/title/context": [
				{
					"command": "dockeryzen.generate",
					"when": "resourceFilename =~ /pom\\.xml|build\\.gradle|build\\.gradle\\.kts/",
					"group": "dockeryzen@1"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "dockeryzen",
					"title": "Dockeryzen",
					"icon": "$(cloud-upload)"
				}
			]
		},
		"views": {
			"dockeryzen": [
				{
					"id": "dockeryzen.dockerExplorer",
					"name": "Docker Explorer",
					"icon": "res/dockeryzen-icon.svg",
					"contextualTitle": "Dockeryzen"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "dockeryzen.dockerExplorer",
				"contents": "No Docker containers found.\n[Generate Docker Files](command:dockeryzen.generate)\n[Analyze Project](command:dockeryzen.analyze)",
				"when": "!dockeryzen.hasContainers"
			}
		],
		"configuration": {
			"title": "Dockeryzen",
			"properties": {
				"dockeryzen.enable": {
					"type": "boolean",
					"default": true,
					"description": "Enable/disable Dockeryzen extension"
				},
				"dockeryzen.defaultJdkImage": {
					"type": "string",
					"default": "eclipse-temurin",
					"enum": [
						"eclipse-temurin",
						"amazon-corretto",
						"openjdk",
						"oracle-jdk",
						"graalvm",
						"liberica",
						"redhat-openjdk"
					],
					"description": "Default JDK base image for Docker"
				},
				"dockeryzen.defaultPort": {
					"type": "number",
					"default": 8080,
					"description": "Default application port"
				},
				"dockeryzen.enableHealthCheck": {
					"type": "boolean",
					"default": true,
					"description": "Enable health check in Dockerfile"
				},
				"dockeryzen.enableDebug": {
					"type": "boolean",
					"default": false,
					"description": "Enable debug mode (port 5005)"
				},
				"dockeryzen.jvmOptions": {
					"type": "string",
					"default": "-Xmx512m -Xms256m",
					"description": "Default JVM options"
				},
				"dockeryzen.databaseType": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"postgresql",
						"mysql",
						"mariadb",
						"mongodb",
						"redis",
						"none"
					],
					"description": "Database type for docker-compose"
				},
				"dockeryzen.outputPath": {
					"type": "string",
					"default": "",
					"description": "Output path for generated files (empty = project root)"
				},
				"dockeryzen.cacheAnalysis": {
					"type": "boolean",
					"default": true,
					"description": "Cache project analysis results"
				},
				"dockeryzen.cacheTimeout": {
					"type": "number",
					"default": 300,
					"description": "Cache timeout in seconds"
				},
				"dockeryzen.imageOptimization": {
					"type": "string",
					"default": "alpine",
					"enum": [
						"alpine",
						"full",
						"slim"
					],
					"description": "Docker image size optimization"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "bun run build",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"build": "tsdown src/extension.ts --external vscode",
		"dev": "bun run build --watch --sourcemap",
		"prepare": "echo 'Skipping update'",
		"update": "echo 'Skipping vscode-ext-gen'",
		"lint": "eslint .",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"ext:package": "vsce package --no-dependencies",
		"ext:publish": "vsce publish --no-dependencies"
	},
	"dependencies": {
		"fs-extra": "^11.2.0",
		"xml2js": "^0.6.2",
		"handlebars": "^4.7.8",
		"dockerode": "^4.0.2"
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0",
		"@types/node": "^20.0.0",
		"@types/fs-extra": "^11.0.4",
		"typescript": "^5.3.0",
		"@antfu/eslint-config": "^6.7.3",
		"@antfu/ni": "^28.0.0",
		"@vscode/vsce": "^3.7.1",
		"bumpp": "^10.3.2",
		"eslint": "^9.39.2",
		"ovsx": "^0.10.7",
		"reactive-vscode": "^1.0.0-beta.2",
		"taze": "^19.9.2",
		"tsdown": "^0.19.0-beta.3",
		"vite": "^7.3.0",
		"vitest": "^4.0.16",
		"vscode-ext-gen": "^1.5.1",
		"vsxpub": "^0.1.2"
	}
}
